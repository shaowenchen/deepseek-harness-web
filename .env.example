# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# The `:?` markers in docker-compose.yml make missing required values a
# hard error at `docker compose up` time.

# ── Model: DeepSeek official API ──────────────────────────────────────────────
# Required. Your DeepSeek API key (https://platform.deepseek.com).
DEEPSEEK_API_KEY=

# Optional. Override the API endpoint (e.g. an OpenAI-compatible gateway/proxy).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Reasoning effort for DeepSeek models: off | low | high | max.
# DSH_LLM_REASONING_EFFORT=high
# Optional. Per-request output token cap.
# DSH_LLM_MAX_TOKENS=256000

# ── Web UI ────────────────────────────────────────────────────────────────────
# Host port the UI is published on (container port is fixed at 3080).
DSH_WEB_PORT=3080

# Optional. Extra authority the /api browser-trust fence accepts, e.g. a domain
# you proxy through:  DSH_TRUSTED_HOST=chat.example.com
# DSH_TRUSTED_HOST=

# ── Agent behavior ────────────────────────────────────────────────────────────
# read-only | workspace-write | danger-full-access
DSH_PERMISSION_MODE=workspace-write
