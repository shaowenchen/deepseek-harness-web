# cp .env.example .env

API_KEY=

# --- 模型路由 ---
# 不设 BASE_URL 时走官方 DeepSeek（API_KEY 即 DeepSeek Key）。
# 自定义 OpenAI 兼容网关（设了则 MODEL 必填）：
# BASE_URL=https://gateway.example/v1
# MODEL=my-model-id

# --- 访问 ---
# PORT=3080
# 域名访问时信任的 Host（可带端口）
# TRUSTED_HOST=chat.example.com

# --- 工作区 ---
# 首次启动在 /root 预建的默认工作区目录（让 web UI 目录选择器有默认项）
# WORKSPACE_DIR=default

# --- S3 持久化（可选）---
# 设了 S3_BUCKET 才启用；此时 S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY 必填
# S3_BUCKET=my-bucket
# S3_PATH=dsh
# S3_ENDPOINT=https://ks3-cn-beijing.ksyuncs.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=cn-beijing
# S3_PATH_STYLE=0   # 0 虚拟主机风格（AWS/金山云），1 path-style（MinIO/自建）

# --- 日志 ---
# LOG_LEVEL=debug
