# cp .env.example .env

API_KEY=

# --- Model routing ---
# No BASE_URL: use official DeepSeek (API_KEY is the DeepSeek key).
# Custom OpenAI-compatible gateway (when set, MODEL is required):
# BASE_URL=https://gateway.example/v1
# MODEL=my-model-id             # comma-separated list for several ids; the first is the default

# --- Access ---
# PORT=3080
# Trusted Host for domain access (may include a port)
# TRUSTED_HOST=chat.example.com

# --- Workspace ---
# Default workspace directory pre-created under /root on first boot
# (gives the web UI's directory picker a ready option)
# WORKSPACE_DIR=default

# --- S3 persistence (optional) ---
# Sync is enabled only when S3_BUCKET is set; then S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY are required
# S3_BUCKET=my-bucket
# S3_PATH=dsh
# S3_ENDPOINT=https://ks3-cn-beijing.ksyuncs.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=cn-beijing
# S3_PATH_STYLE=0   # 0 virtual-host style (AWS/Kingsoft), 1 path-style (MinIO/self-hosted); auto for localhost/IP

# --- Logging ---
# LOG_LEVEL=debug
