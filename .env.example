# cp .env.example .env

API_KEY=

# Custom OpenAI-compatible gateway (optional). When set, MODEL is required.
# BASE_URL=https://gateway.example/v1
# MODEL=my-model-id

# PORT=3080

# Domain access: browser Host (may include port)
# TRUSTED_HOST=chat.example.com
# TRUSTED_HOST=chat.example.com:8443

# Persist /workspace to S3 via Node SDK sync (@aws-sdk/client-s3, no FUSE needed).
# When S3_BUCKET is set, the others are required.
# S3_BUCKET=my-bucket
# S3_PATH=optional/subpath
# S3_ENDPOINT=https://ks3-cn-beijing.ksyuncs.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PATH_STYLE=0   # 0 virtual-host (AWS/KS3 official domains), 1 path-style (MinIO/self-hosted)
# S3_REGION=cn-beijing

# LOG_LEVEL=debug   # 预留；同步文件日志默认打印（本地绝对路径 ↔ s3://）

# 首次启动时在 /workspace 下预建的默认工作区目录名（未配 S3 时生效），让 web UI 的目录选择器有默认项
# WORKSPACE_DIR=default
