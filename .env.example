# cp .env.example .env

API_KEY=

# Custom OpenAI-compatible gateway (optional). When set, MODEL is required.
# BASE_URL=https://gateway.example/v1
# MODEL=my-model-id

# PORT=3080

# Domain access: browser Host (may include port)
# TRUSTED_HOST=chat.example.com
# TRUSTED_HOST=chat.example.com:8443

# Persist /workspace to S3. Priority: s3fs mount (needs /dev/fuse + SYS_ADMIN),
# else falls back to rclone sync (no FUSE needed; works on Railway).
# When S3_BUCKET is set, the others are required.
# S3_BUCKET=my-bucket
# S3_PATH=optional/subpath
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PATH_STYLE=1
# S3_REGION=
# SYNC_INTERVAL=30
